# Local machine config — carries local paths/model names, never committed (see HERMES.local.md header)
HERMES.local.md

# Runtime data — personal, regenerated locally, not source
logs/*.jsonl
logs/*.json
logs/debug.log

# Audit/proof evidence — local working records (gate proofs, coverage audits), never uploaded
logs/*.md
docs/EXTRACTION_COVERAGE.md
docs/SRC_PATTERNS_*.md

# FUSE mount litter (Cowork/network mounts leave these behind)
**/.fuse_hidden*
**/.fuse_probe
mnemos/vault/*.db*
mnemos/vault/hnsw*/
mnemos/vault/MEMORY.md
mnemos/dream/
curator/reflexion.json
curator/pending/*.json
curator/approved/*.json
curator/archived/*.json
reasoningbank/hnsw/
reasoningbank/task_log.jsonl
clio/*.jsonl

# Secrets & credentials — never commit, security tool going public (proactive)
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.crt
id_rsa*
id_ed25519*
secrets/
*.secret
*_secret*
credentials.json

# Any local override variant of machine config
*.local.md
!HERMES.local.md.example

# Claude Code local settings — carries absolute paths + local tool permissions.
# The "local" suffix is Claude Code's own convention for machine-specific config.
# Commit .claude/settings.json (shared) if you want; never the .local one.
.claude/settings.local.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Extra runtime safety nets (broader than exact filenames above)
logs/*.log
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

cron/cron.db*
cron/.tick.lock
delegation/agenda/
logs/.approved/
meta/upstreams.json
integrations/db/*.sqlite*
integrations/kanban.db*
integrations/composio_registry.json

# Cowork-local CLAUDE_CONFIG_DIR — durable runtime state (upstream watchlist,
# etc.) redirected here because Cowork's sandbox $HOME isn't persistent, but
# this workspace folder is. See meta/paths.py. Split into two dirs (batch1/
# batch2) so the 2am/3am upstream-watch scheduled tasks each get their own
# 26-repo slice and stay under GitHub's 60 req/hr anonymous rate limit.
.claude_config/
.claude_config_batch1/
.claude_config_batch2/
